{{define "signup.tmpl"}}
{{template "head" .}}
{{template "nav" .}}
<main class="auth-page">
  <section class="auth-card">
    <h1>注册账号</h1>
    {{template "flash" .}}
    <form method="post" action="/user/sign_up" class="stack-form">
      <label>用户名 <input name="name" autocomplete="username" required></label>
      <label>邮箱 <input name="email" type="email" autocomplete="email" required></label>
      <label>密码 <input name="password" type="password" minlength="8" autocomplete="new-password" required></label>
      <button class="primary" type="submit">创建账号</button>
    </form>
  </section>
</main>
{{template "foot" .}}
{{end}}
