{{define "settings.tmpl"}}
{{template "head" .}}
{{template "nav" .}}
<main class="settings-shell">
  <aside class="settings-menu" aria-label="用户设置菜单">
    <div class="settings-menu-title">用户设置</div>
    <a class="active" href="#profile" data-settings-nav>个人信息</a>
    <a href="#account" data-settings-nav>账号</a>
    <a href="#appearance" data-settings-nav>外观</a>
  </aside>

  <section class="settings-content">
    {{template "flash" .}}

    <section class="settings-panel active" id="profile" data-settings-panel>
      <div class="panel-card">
        <header class="panel-header">
          <h1>公开信息</h1>
        </header>
        <form method="post" action="/user/settings/profile" class="gitea-form">
          <input type="hidden" name="_csrf" value="{{.CSRF}}">
          <p class="muted">控制您的个人资料对其他用户的显示方式。</p>
          <label>用户名
            <input value="{{.ProfileUser.Name}}" disabled>
          </label>
          <label>自定义名称
            <input name="full_name" value="{{.ProfileUser.FullName}}">
          </label>
          <label>电子邮件地址
            <input name="email" type="email" value="{{.ProfileUser.Email}}" required>
          </label>
          <label>简介
            <textarea name="description" rows="4" placeholder="告诉我们一点您自己！">{{.ProfileUser.Description}}</textarea>
          </label>
          <label>个人网站
            <input name="website" value="{{.ProfileUser.Website}}">
          </label>
          <label>所在地区
            <input name="location" value="{{.ProfileUser.Location}}" placeholder="与他人分享你的大概位置">
          </label>
          <label>头像 URL
            <input name="avatar_url" value="{{.ProfileUser.AvatarURL}}" placeholder="https://example.com/avatar.png">
          </label>
          <div class="form-actions">
            <button class="primary" type="submit">更新信息</button>
          </div>
        </form>
      </div>
    </section>

    <section class="settings-panel" id="account" data-settings-panel>
      <div class="panel-card">
        <header class="panel-header">
          <h1>账号</h1>
        </header>
        <form method="post" action="/user/settings/password" class="gitea-form">
          <input type="hidden" name="_csrf" value="{{.CSRF}}">
          <p class="muted">修改您的登录密码。新密码至少需要 8 个字符。</p>
          <label>当前密码
            <input name="current_password" type="password" autocomplete="current-password" required>
          </label>
          <label>新密码
            <input name="new_password" type="password" autocomplete="new-password" minlength="8" required>
          </label>
          <label>确认新密码
            <input name="confirm_password" type="password" autocomplete="new-password" minlength="8" required>
          </label>
          <div class="form-actions">
            <button class="primary" type="submit">更新密码</button>
          </div>
        </form>
      </div>
    </section>

    <section class="settings-panel" id="appearance" data-settings-panel>
      <div class="panel-card">
        <header class="panel-header">
          <h1>外观</h1>
        </header>
        <form method="post" action="/user/settings/theme" class="gitea-form">
          <input type="hidden" name="_csrf" value="{{.CSRF}}">
          <p class="muted">选择界面主题。保存后会应用到所有页面。</p>
          <div class="theme-options">
            <label class="theme-option">
              <input type="radio" name="theme" value="light" {{if ne .ProfileUser.Theme "dark"}}checked{{end}}>
              <span>
                <strong>浅色主题</strong>
                <small>适合明亮环境，页面背景和内容面板保持浅色。</small>
              </span>
            </label>
            <label class="theme-option">
              <input type="radio" name="theme" value="dark" {{if eq .ProfileUser.Theme "dark"}}checked{{end}}>
              <span>
                <strong>深色主题</strong>
                <small>适合夜间使用，导航、表单和内容区域统一为深色。</small>
              </span>
            </label>
          </div>
          <div class="form-actions">
            <button class="primary" type="submit">保存主题</button>
          </div>
        </form>
      </div>
    </section>
  </section>
</main>
{{template "foot" .}}
{{end}}
