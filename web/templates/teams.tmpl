{{define "teams.tmpl"}}
{{template "head" .}}
{{template "nav" .}}
<main class="page two-column">
  <section>
    <div class="page-title compact">
      <div>
        <p class="eyebrow">协作空间</p>
        <h1>团队</h1>
      </div>
    </div>
    <div class="content-list">
      {{range .Teams}}
        <article class="item-card">
          <a class="item-title" href="/teams/{{.Name}}">{{.DisplayName}}</a>
          <p>{{.Description}}</p>
          <div class="meta">{{.Name}} · {{formatTime .Updated}}</div>
        </article>
      {{else}}
        <div class="empty">你还没有加入团队。</div>
      {{end}}
    </div>
  </section>
  <aside class="side-panel">
    <h2>创建团队</h2>
    <form id="create-team-form" class="stack-form">
      <label>团队标识 <input name="name" required></label>
      <label>显示名称 <input name="display_name"></label>
      <label>描述 <textarea name="description" rows="4"></textarea></label>
      <button class="primary" type="submit">创建</button>
    </form>
  </aside>
</main>
{{template "foot" .}}
{{end}}
