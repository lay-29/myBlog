{{define "team.tmpl"}}
{{template "head" .}}
{{template "nav" .}}
<main class="page two-column">
  <section>
    <div class="page-title compact">
      <div>
        <p class="eyebrow">团队</p>
        <h1>{{.Team.DisplayName}}</h1>
        <p class="muted">{{.Team.Description}}</p>
      </div>
    </div>
    <div class="content-list">
      {{range .Spaces}}
        <article class="item-card">
          <a class="item-title" href="/teams/{{$.Team.Name}}/{{.Name}}">{{.DisplayName}}</a>
          <p>{{.Description}}</p>
          <div class="meta">{{.Visibility}} · {{formatTime .Updated}}</div>
        </article>
      {{else}}
        <div class="empty">团队里还没有空间。</div>
      {{end}}
    </div>
  </section>
  <aside class="side-panel">
    <h2>新建空间</h2>
    <form id="create-space-form" class="stack-form">
      <input type="hidden" name="team_id" value="{{.Team.ID}}">
      <label>空间标识 <input name="name" required></label>
      <label>显示名称 <input name="display_name"></label>
      <label>可见性
        <select name="visibility">
          <option value="team">团队内</option>
          <option value="public">公开</option>
          <option value="private">私有</option>
        </select>
      </label>
      <label>描述 <textarea name="description" rows="4"></textarea></label>
      <button class="primary" type="submit">创建空间</button>
    </form>
    <hr>
    <h2>添加成员</h2>
    <form id="add-member-form" data-team-id="{{.Team.ID}}" class="stack-form">
      <label>用户名 <input name="username" required></label>
      <label>角色
        <select name="role">
          <option value="member">成员</option>
          <option value="admin">管理员</option>
          <option value="owner">所有者</option>
        </select>
      </label>
      <button type="submit">添加</button>
    </form>
  </aside>
</main>
{{template "foot" .}}
{{end}}
